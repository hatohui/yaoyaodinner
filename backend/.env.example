# Database
DATABASE_URL="postgresql://root:root@localhost:5434/yaoyao?schema=public"
# Only for `task db:import:old`: the pre-events database to copy people and orders from
OLD_DATABASE_URL=

# Redis
REDIS_URL=redis://:pass@localhost:6379/0

# Storage (MinIO for local dev, leave S3_ENDPOINT blank and set CLOUDFLARE_ACCOUNT_ID for R2)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
BUCKET_NAME=yaoyao
CLOUDFLARE_ACCESS_KEY_ID=root
CLOUDFLARE_SECRET_ACCESS_KEY=rootpassword
S3_ENDPOINT=http://localhost:9002
CORS_ORIGIN=http://localhost:5173,https://yaoyaodinner.party,https://www.yaoyaodinner.party

# App
PORT=8080
NODE_ENV=development

# Admin gate (hidden easter-egg passphrase, not a real auth boundary)
ADMIN_PASSPHRASE=yaoyao

# Google AI (Gemini) for background food/category translation
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=
